# ============================================================
# DIGITALTECH — CONFIGURAÇÃO DE AMBIENTE
# ============================================================
# NUNCA envie este arquivo para o GitHub.
# O arquivo .env deve permanecer no .gitignore.
# ============================================================


# ============================================================
# 1. APLICAÇÃO — FASTAPI
# ============================================================

ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8000
PORT=8000

# Gere uma chave real com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua_por_um_hash_seguro_de_64_caracteres

CORS_ORIGINS=*


# ============================================================
# 2. BANCO DE DADOS
# ============================================================

# ------------------------------------------------------------
# PostgreSQL / Neon — produção
# ------------------------------------------------------------

# DATABASE_URL=postgresql+psycopg2://usuario:senha@host.neon.tech:5432/banco?sslmode=require

# ------------------------------------------------------------
# PostgreSQL local
# ------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------
# Banco utilizado atualmente
# ------------------------------------------------------------

DATABASE_URL=sqlite:///./digitaltech.db

# ------------------------------------------------------------
# Pool de conexões
# ------------------------------------------------------------

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# ============================================================
# 3. OLLAMA — MODELOS LOCAIS
# ============================================================

OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_MODEL=qwen2.5:3b
DEFAULT_MODEL=llama3.1:70b
FALLBACK_MODEL=llama3.1:8b

MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096

OLLAMA_TIMEOUT=120


# ============================================================
# 4. OPENAI
# ============================================================

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1


# ============================================================
# 5. ANTHROPIC / CLAUDE
# ============================================================

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com


# ============================================================
# 6. GOOGLE GEMINI
# ============================================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Compatibilidade com código que utilize GOOGLE_API_KEY
GOOGLE_API_KEY=


# ============================================================
# 7. GROQ
# ============================================================

GROQ_API_KEY=


# ============================================================
# 8. GROK / XAI
# ============================================================

GROK_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1


# ============================================================
# 9. DEEPSEEK
# ============================================================

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com


# ============================================================
# 10. PERPLEXITY
# ============================================================

PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai


# ============================================================
# 11. HUGGING FACE
# ============================================================

HF_TOKEN=
HUGGINGFACE_API_KEY=


# ============================================================
# 12. KIMI / MOONSHOT AI
# ============================================================

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Compatibilidade
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1


# ============================================================
# 13. MISTRAL AI
# ============================================================

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1


# ============================================================
# 14. COHERE
# ============================================================

COHERE_API_KEY=


# ============================================================
# 15. TOGETHER AI
# ============================================================

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1


# ============================================================
# 16. OPENROUTER
# ============================================================

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Opcional — identificação da aplicação
OPENROUTER_APP_NAME=DigitalTech
OPENROUTER_SITE_URL=


# ============================================================
# 17. SUPERMEMORY
# ============================================================

SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai


# ============================================================
# 18. GITHUB — PUBLICAÇÃO AUTOMÁTICA
# ============================================================

GITHUB_TOKEN=

GITHUB_OWNER=AdminFreitas

GITHUB_REPOSITORY=digitaltech

GITHUB_REPO=AdminFreitas/digitaltech

GITHUB_BRANCH=main

GITHUB_CONTENT_PATH=artigos

GITHUB_AUTHOR_NAME=DigitalTech Bot

GITHUB_AUTHOR_EMAIL=bot@digitaltech.local


# ============================================================
# 19. AUTOR DO AGENTE
# ============================================================

AGENTE_AUTOR_ID=2


# ============================================================
# 20. IMAGENS
# ============================================================

# Unsplash
UNSPLASH_ACCESS_KEY=

# Pexels
PEXELS_API_KEY=

# Pixabay
PIXABAY_API_KEY=

# Openverse — não exige chave
OPENVERSE_API_URL=https://api.openverse.org/v1/images/

# Pollinations — não exige chave
POLLINATIONS_API_URL=https://image.pollinations.ai/


# ============================================================
# 21. PESQUISA NA WEB
# ============================================================

# SerpAPI
SERPAPI_KEY=

# NewsAPI
NEWSAPI_KEY=

# Tavily
TAVILY_API_KEY=

# Perplexity também pode ser utilizada como mecanismo
# de pesquisa pelo agente
PERPLEXITY_API_KEY=

SEARCH_LANGUAGE=pt-BR
SEARCH_REGION=BR


# ============================================================
# 22. AGENTE EDITORIAL
# ============================================================

ARTIGO_CATEGORIAS=Inteligência Artificial,Tecnologia,Programação,Ciência de Dados,Cybersegurança,Cloud Computing,DevOps,Mobile,Web,Blockchain

NOTICIA_CATEGORIAS=Tecnologia,IA,Startups,Segurança,Hardware,Software,Eventos,Regulamentação

TONS_ESCRITA=tecnico,divulgativo,tutorial,opiniao,analitico,jornalistico

TAMANHOS_ARTIGO=curto,medio,longo,epico

MAX_ARTIGOS_POR_DIA=20
MAX_NOTICIAS_POR_DIA=10


# ============================================================
# 23. FALLBACK / ORQUESTRAÇÃO DE LLM
# ============================================================

# Ordem preferencial dos provedores.
# O agente deve tentar o próximo quando o anterior falhar.

FALLBACK_ORDER=gemini,groq,deepseek,perplexity,grok,huggingface,mistral,cohere,together,openrouter,kimi,openai,anthropic,ollama


# ============================================================
# 24. CONFIGURAÇÃO DE GERAÇÃO
# ============================================================

MODEL_PROVIDER=

TEMPERATURE=0.7

MAX_TOKENS=4096

REQUEST_TIMEOUT=120

MAX_RETRIES=2


# ============================================================
# 25. SEO / GEO
# ============================================================

FEATURE_SEO_REVIEW=true

FEATURE_GEO=true

SEO_MAX_TITLE_LENGTH=60

SEO_MAX_META_DESCRIPTION_LENGTH=155

SEO_MAX_TAGS=8

SEO_GENERATE_ALT_TEXT=true

SEO_GENERATE_OPEN_GRAPH=true

SEO_GENERATE_STRUCTURED_DATA=true

SEO_GENERATE_INTERNAL_LINKS=true

SEO_GENERATE_EXTERNAL_LINKS=true


# ============================================================
# 26. PUBLICAÇÃO
# ============================================================

FEATURE_ARTIGOS=true

FEATURE_NOTICIAS=true

FEATURE_GITHUB_PUBLISH=true

FEATURE_AGENDAMENTO=false

FEATURE_IMAGENS=true

FEATURE_SEO_REVIEW=true

PUBLICAR_IMEDIATAMENTE=true


# ============================================================
# 27. LIMITES DE SEGURANÇA EDITORIAL
# ============================================================

MAX_ARTIGOS_POR_DIA=20

MAX_NOTICIAS_POR_DIA=10

MAX_POSTS_LINKEDIN_POR_DIA=2

MAX_EMAILS_POR_HORA=50


# ============================================================
# 28. LOGGING
# ============================================================

LOG_LEVEL=INFO

LOG_FILE=logs/digitaltech.log

LOG_FORMAT=%(asctime)s | %(levelname)s | %(name)s | %(message)s

LOG_LLM_REQUESTS=false


# ============================================================
# 29. API / DASHBOARD
# ============================================================

APP_DOMAIN=http://localhost:8000

APP_PUBLIC_URL=

FORCE_HTTPS=false

WORKERS=1


# ============================================================
# 30. SEGURANÇA / RATE LIMITING
# ============================================================

RATE_LIMIT_PER_MINUTE=30

REQUIRE_API_KEY=false

ALLOWED_API_KEYS=


# ============================================================
# 31. LINKEDIN
# ============================================================

LINKEDIN_ACCESS_TOKEN=

LINKEDIN_PERSON_URN=

LINKEDIN_CLIENT_ID=

LINKEDIN_CLIENT_SECRET=

LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback


# ============================================================
# 32. E-MAIL
# ============================================================

EMAIL_HOST=

EMAIL_PORT=587

EMAIL_USER=

EMAIL_PASSWORD=

EMAIL_FROM=

EMAIL_FROM_NAME=DigitalTech

EMAIL_USE_TLS=true


# ============================================================
# 33. WHATSAPP — FUTURO
# ============================================================

WHATSAPP_ACCESS_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=

WHATSAPP_BUSINESS_ACCOUNT_ID=


# ============================================================
# 34. FACEBOOK PAGE — FUTURO
# ============================================================

FACEBOOK_ACCESS_TOKEN=

FACEBOOK_PAGE_ID=

FACEBOOK_APP_ID=

FACEBOOK_APP_SECRET=


# ============================================================
# 35. INSTAGRAM — FUTURO
# ============================================================

INSTAGRAM_ACCESS_TOKEN=

INSTAGRAM_BUSINESS_ACCOUNT_ID=

INSTAGRAM_APP_ID=

INSTAGRAM_APP_SECRET=


# ============================================================
# 36. X / TWITTER — FUTURO
# ============================================================

X_API_KEY=

X_API_SECRET=

X_ACCESS_TOKEN=

X_ACCESS_TOKEN_SECRET=

X_BEARER_TOKEN=

X_CLIENT_ID=

X_CLIENT_SECRET=


# ============================================================
# 37. MEMÓRIA DO AGENTE
# ============================================================

MEMORY_ENABLED=true

MEMORY_PROVIDER=supermemory

SUPERMEMORY_API_KEY=

SUPERMEMORY_BASE_URL=https://api.supermemory.ai


# ============================================================
# 38. CORS
# ============================================================

CORS_ORIGINS=*


# ============================================================
# 39. AMBIENTE
# ============================================================

PYTHONUNBUFFERED=1


# ============================================================
# FIM DO .ENV
# ============================================================