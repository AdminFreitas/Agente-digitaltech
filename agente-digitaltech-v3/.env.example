# ==========================================================
# Agente DigitalTech — Variáveis de Ambiente
# ==========================================================
# Copie este arquivo para .env e preencha os valores.
# Você precisa de APENAS UMA chave de IA na nuvem: OPENROUTER_API_KEY
# Ollama é gratuito e local — não precisa de chave.
# ==========================================================

# ----------------------------------------------------------
# Ambiente
# ----------------------------------------------------------
ENVIRONMENT=development

# ----------------------------------------------------------
# Banco de Dados (Neon ou PostgreSQL local)
# ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://user:pass@host:port/db
# OU configure separado:
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=agente_ads
# DB_USER=digitaltech
# DB_PASSWORD=sua_senha

# ----------------------------------------------------------
# Ollama (Local — gratuito, sem chave)
# ----------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180

# ----------------------------------------------------------
# OpenRouter (Hub central — UMA chave, MÚLTIPLOS modelos)
# ----------------------------------------------------------
# Cadastre-se em https://openrouter.ai/keys
# Modelos disponíveis: GPT, Claude, Gemini, Kimi, DeepSeek e mais
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ----------------------------------------------------------
# APIs de Imagens (gratuitas — opcionais)
# ----------------------------------------------------------
UNSPLASH_ACCESS_KEY=your_unsplash_key
PEXELS_API_KEY=your_pexels_key
PIXABAY_API_KEY=your_pixabay_key
OPENVERSE_CLIENT_ID=your_openverse_id
OPENVERSE_CLIENT_SECRET=your_openverse_secret

# ----------------------------------------------------------
# Geração de Imagens (opcionais)
# ----------------------------------------------------------
# Stable Diffusion local (ex: Automatic1111, ComfyUI)
# STABLE_DIFFUSION_URL=http://localhost:7860

# ----------------------------------------------------------
# GitHub (para publicação automática)
# ----------------------------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=AdminFreitas
GITHUB_REPOSITORY=DigitalTech
GITHUB_BRANCH=main

# ----------------------------------------------------------
# Comportamento do Agente
# ----------------------------------------------------------
PUBLICAR_IMEDIATAMENTE=true
