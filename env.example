# ============================================================
# DigitalTech — Arquivo de Configuração (.env)
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commit o arquivo .env no GitHub (já está no .gitignore).
# ============================================================


# ============================================================
# 1. APLICAÇÃO — FastAPI
# ============================================================

# Ambiente: development | staging | production
ENVIRONMENT=development

# Host e porta do servidor FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Secret para tokens JWT (se usar autenticação no futuro)
# Gere com: openssl rand -hex 32
SECRET_KEY=substitua_por_um_hash_seguro_de_64_caracteres

# CORS — origens permitidas (separadas por vírgula)
# Em desenvolvimento, use * para permitir tudo
# Em produção, restrinja: https://seu-dominio.com,https://app.seudominio.com
CORS_ORIGINS=*


# ============================================================
# 2. OLLAMA — Modelos Locais
# ============================================================

# URL base do servidor Ollama (padrão: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo padrão para geração de artigos e notícias
# Opções disponíveis localmente:
#   llama3.1:70b, llama3.1:8b, llama3.2, llama3.2:1b
#   mistral-large, mistral:7b, mixtral:8x7b
#   qwen2.5:72b, qwen2.5:14b, qwen2.5:7b
#   codellama:34b, deepseek-coder:33b
DEFAULT_MODEL=llama3.1:70b

# Modelo fallback (usado se o principal falhar)
FALLBACK_MODEL=llama3.1:8b

# Temperatura do modelo (0.0 = determinístico, 1.0 = criativo)
MODEL_TEMPERATURE=0.7

# Máximo de tokens por resposta
MODEL_MAX_TOKENS=4096

# Timeout em segundos para requisições ao Ollama
OLLAMA_TIMEOUT=120


# ============================================================
# 3. MODELOS CLOUD — API Keys (opcionais)
# ============================================================
# Descomente e preencha para habilitar modelos na nuvem.
# O dashboard mostrará esses modelos como "disponíveis" 
# automaticamente quando as keys estiverem configuradas.

# OpenAI — GPT-4o, GPT-4o-mini, GPT-4-turbo
# OPENAI_API_KEY=sk-proj-sua-chave-aqui
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — Claude 3.5 Sonnet, Claude 3 Opus
# ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google — Gemini 1.5 Pro, Gemini 1.5 Flash
# GOOGLE_API_KEY=sua-chave-gemini-aqui

# Groq — Mixtral, Llama 3.1 (inferência rápida e barata)
# GROQ_API_KEY=gsk_sua-chave-aqui

# Cohere — Command R+
# COHERE_API_KEY=sua-chave-aqui

# Together AI — diversos modelos open-source na nuvem
# TOGETHER_API_KEY=sua-chave-aqui


# ============================================================
# 4. GITHUB — Publicação de Artigos
# ============================================================

# Token de acesso pessoal do GitHub
# Crie em: https://github.com/settings/tokens
# Escopos necessários: repo, read:user
GITHUB_TOKEN=ghp_seu_token_aqui

# Repositório onde os artigos serão publicados
# Formato: usuario/nome-do-repo
GITHUB_REPO=seu-usuario/digitaltech-artigos

# Branch principal do repositório
GITHUB_BRANCH=main

# Caminho dentro do repo onde os artigos ficam
GITHUB_CONTENT_PATH=artigos

# Nome do autor que aparece nos commits
GITHUB_AUTHOR_NAME=DigitalTech Bot
GITHUB_AUTHOR_EMAIL=bot@digitaltech.local


# ============================================================
# 5. BANCO DE DADOS
# ============================================================

# URL de conexão com o banco
# SQLite (desenvolvimento):
DATABASE_URL=sqlite:///./digitaltech.db

# PostgreSQL (produção):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/digitaltech

# MySQL (alternativa):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/digitaltech

# Pool de conexões (produção)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# ============================================================
# 6. AGENTE EDITORIAL — Configurações
# ============================================================

# Categorias disponíveis para artigos (separadas por vírgula)
ARTIGO_CATEGORIAS=Inteligência Artificial,Tecnologia,Programação,Ciência de Dados,Cybersegurança,Cloud Computing,DevOps,Mobile,Web,Blockchain

# Categorias disponíveis para notícias
NOTICIA_CATEGORIAS=Tecnologia,IA,Startups,Segurança,Hardware,Software,Eventos,Regulamentação

# Tons de escrita disponíveis
TONS_ESCRITA=tecnico,divulgativo,tutorial,opiniao,analitico,jornalistico

# Tamanhos de artigo
TAMANHOS_ARTIGO=curto,medio,longo,epico

# Número máximo de artigos gerados por dia (evita spam)
MAX_ARTIGOS_POR_DIA=20

# Número máximo de notícias geradas por dia
MAX_NOTICIAS_POR_DIA=10


# ============================================================
# 7. PESQUISA NA WEB — Fontes de Notícias
# ============================================================

# API Key do SerpAPI (para busca no Google)
# Crie em: https://serpapi.com/
# SERPAPI_KEY=sua-chave-aqui

# API Key do NewsAPI (para notícias)
# Crie em: https://newsapi.org/
# NEWSAPI_KEY=sua-chave-aqui

# API Key do Tavily (para busca com IA)
# Crie em: https://tavily.com/
# TAVILY_API_KEY=sua-chave-aqui

# Idioma padrão para buscas
SEARCH_LANGUAGE=pt-BR

# Região padrão para buscas
SEARCH_REGION=BR


# ============================================================
# 8. LOGGING & MONITORAMENTO
# ============================================================

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Arquivo de log (deixe vazio para logar apenas no console)
LOG_FILE=logs/digitaltech.log

# Formato do log
LOG_FORMAT=%(asctime)s | %(levelname)s | %(name)s | %(message)s

# Ativar logs detalhados do LLM (útil para debug)
LOG_LLM_REQUESTS=false


# ============================================================
# 9. HOSPEDAGEM & DEPLOY
# ============================================================

# Domínio da aplicação (usado no dashboard e em links)
APP_DOMAIN=http://localhost:8000

# URL pública do dashboard (para links de compartilhamento)
# APP_PUBLIC_URL=https://digitaltech.seudominio.com

# Ativar HTTPS redirect (produção)
FORCE_HTTPS=false

# Workers do Uvicorn (produção)
# WORKERS=4


# ============================================================
# 10. SEGURANÇA & RATE LIMITING
# ============================================================

# Número máximo de requisições por minuto por IP
RATE_LIMIT_PER_MINUTE=30

# Ativar autenticação por API Key (para uso externo)
REQUIRE_API_KEY=false

# API Keys válidas (separadas por vírgula, para integrações externas)
# ALLOWED_API_KEYS=key1,key2,key3


# ============================================================
# 11. FEATURE FLAGS — Ativar/Desativar Funcionalidades
# ============================================================

# Permitir geração de artigos
FEATURE_ARTIGOS=true

# Permitir geração de notícias
FEATURE_NOTICIAS=true

# Permitir publicação automática no GitHub
FEATURE_GITHUB_PUBLISH=true

# Permitir agendamento de publicações
FEATURE_AGENDAMENTO=false

# Permitir geração de imagens com IA (DALL-E, Stable Diffusion)
FEATURE_IMAGENS=false

# Permitir revisão automática de SEO
FEATURE_SEO_REVIEW=true


# ============================================================
# FIM DO ARQUIVO
# ============================================================
# Dica: Use o comando abaixo para gerar uma SECRET_KEY segura:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
