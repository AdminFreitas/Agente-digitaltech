# ============================================================
# Agente DigitalTech — Configuração de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ---------------------------------------------------------
# BANCO DE DADOS (Neon ou PostgreSQL local)
# ---------------------------------------------------------
# Opção 1: URL completa (recomendado para Neon)
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host.neon.tech:5432/banco?sslmode=require

# Opção 2: Variáveis separadas (usado pelo docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# ---------------------------------------------------------
# OLLAMA (modelo local — gratuito, sem chave)
# ---------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# NOTA: qwen2.5:3b em CPU (Aspire E1-571) leva ~150-300s para gerar artigo.
# Se timeout persistir, aumente no llm_service.py ou use modelo maior em GPU.

# ---------------------------------------------------------
# OPENAI (gpt-4o-mini) — pago, requer créditos na conta
# ---------------------------------------------------------
# Erro 429 = quota excedida → adicione créditos em platform.openai.com
OPENAI_API_KEY=

# ---------------------------------------------------------
# ANTHROPIC (Claude Haiku) — pago, requer chave válida
# ---------------------------------------------------------
# Erro 401 = chave inválida → verifique em console.anthropic.com
# Modelo válido: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# ---------------------------------------------------------
# GEMINI (gemini-3.6-flash) — gratuito com limites
# ---------------------------------------------------------
# Modelos 1.x, 2.x e 2.5 foram descontinuados (erro 404).
# Use gemini-3.6-flash ou gemini-3.5-flash-lite.
# Obtenha chave em: aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------
# GITHUB (publicação automática no blog)
# ---------------------------------------------------------
# Token com permissão repo → github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=AdminFreitas
GITHUB_REPOSITORY=digitaltech
GITHUB_REPO=AdminFreitas/digitaltech
GITHUB_BRANCH=main

# ---------------------------------------------------------
# AGENTE
# ---------------------------------------------------------
# ID do autor no banco (tabela autores) — deve existir no schema
AGENTE_AUTOR_ID=2

# ---------------------------------------------------------
# API (FastAPI)
# ---------------------------------------------------------
PORT=8000

# ---------------------------------------------------------
# IMAGENS (chaves opcionais — sem elas usa Openverse/Pollinations)
# ---------------------------------------------------------
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
